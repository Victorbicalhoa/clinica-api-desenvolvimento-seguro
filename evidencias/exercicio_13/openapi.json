        "type": "string",
        "enum": [
          "http",
          "consulta.criar",
          "consulta.atualizar",
          "consulta.excluir"
        ],
        "title": "AcaoAuditoria"
      },
      "AdminRead": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "mfa_verified": {
            "type": "boolean",
            "title": "Mfa Verified"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "mfa_verified"
        ],
        "title": "AdminRead"
      },
      "AuditoriaRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "instante": {
            "type": "string",
            "format": "date-time",
            "title": "Instante"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "ator_id": {
