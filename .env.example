# Configuracao de demonstracao, sem credenciais ou segredos.
DATABASE_URL=sqlite:///./data/clinica_exercicio09.db
ACCESS_TOKEN_MINUTES=15
MFA_SIMULATED=false
COOKIE_SECURE=true
AUTH_LOGIN_LIMIT=5
AUTH_MFA_LIMIT=5
AUTH_IP_LIMIT=60
AUTH_WINDOW_SECONDS=60
# JWT_SECRET ausente: chave aleatoria por processo, invalidada ao reiniciar.
# Em implantacao, injetar chave forte compartilhada sem versiona-la.
# Apenas demonstracao HTTP em 127.0.0.1: COOKIE_SECURE=false
# Apenas demonstracao local com OTP no terminal: MFA_SIMULATED=true
# Origens exatas do frontend; trocar por HTTPS do dominio real na implantacao.
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOGIN_IP_LIMIT=20
API_REQUEST_LIMIT=120
HSTS_MAX_AGE=31536000
MAX_REQUEST_BODY_BYTES=65536
# SQLite e relacional e persiste em arquivo; nao utiliza usuario/senha de banco.
# Caminho relativo resolvido a partir da raiz do projeto, independente do diretorio atual.
# Copiar para .env somente no ambiente local. Nunca incluir .env ou bancos na entrega.
