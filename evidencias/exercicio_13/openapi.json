    "/auth/token": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Login",
        "operationId": "login_auth_token_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenRead"
                }
              }
            }
          },
          "202": {
            "description": "MFA administrativo pendente; sem access_token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesafioRead"
                }
              }
            }
          },
          "413": {
            "description": "Corpo maior que o limite configurado."
          },
          "429": {
            "description": "Orcamento esgotado; consultar Retry-After.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "401": {
            "description": "Autenticacao negada."
          },
          "422": {
            "description": "Entrada invalida."
          },
          "503": {
            "description": "MFA, persistencia ou auditoria indisponivel."
          },
          "415": {
            "description": "Tipo de formulario nao suportado."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "grant_type": {
                    "const": "password",
                    "title": "Grant Type",
                    "type": "string"
                  },
                  "username": {
                    "pattern": "^[A-Za-z0-9._-]{1,100}$",
                    "title": "Username",
                    "type": "string"
                  },
                  "password": {
                    "format": "password",
                    "title": "Password",
                    "type": "string",
                    "writeOnly": true
                  },
                  "scope": {
                    "const": "",
                    "default": "",
                    "title": "Scope",
                    "type": "string"
                  },
                  "client_id": {
                    "const": "",
                    "default": "",
                    "title": "Client Id",
                    "type": "string"
                  },
                  "client_secret": {
                    "const": "",
                    "default": "",
                    "title": "Client Secret",
                    "type": "string"
                  }
                },
                "required": [
                  "grant_type",
                  "username",
                  "password"
                ],
                "title": "LoginForm",
                "type": "object"
              }
            }
          }
        },
        "description": "OAuth2 password para humanos. Administrador recebe 202 e deve confirmar /auth/mfa; depois pode usar JWTBearer no Swagger. Nao ha fluxo M2M nesta versao. Senha limitada a 72 bytes UTF-8; campos duplicados, extras e query sao rejeitados."
      }
    },
